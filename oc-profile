cmd_init() {
  local layout_state
  layout_state="$(detect_layout_state)"

  case "${layout_state}" in
    initialized)
      success "already initialized."
      return 0
      ;;
    legacy)
      die_with_code "${E_LEGACY}" "legacy layout detected; run 'oc-profile migrate' first."
      ;;
    broken)
      die_with_code "${E_GENERIC}" "layout is inconsistent; cannot auto-initialize safely. Back up ${AUTH_DIR} and repair manually."
      ;;
    fresh)
      ;;
    *)
      die_with_code "${E_GENERIC}" "unknown layout state '${layout_state}'."
      ;;
  esac

  log_v "Acquiring lock..."
  acquire_lock
  ensure_dirs
  require_jq >/dev/null

  # If auth.json is a regular file, preserve it first, then promote as active.
  if [[ -f "${AUTH_FILE}" && ! -L "${AUTH_FILE}" ]]; then
    log_v "Backing up existing auth.json before initialization..."
    run_mutation_fn "backup existing auth file ${AUTH_FILE}" backup_auth_file "${AUTH_FILE}"

    log_v "Promoting existing auth.json to live credentials file..."
    run_mutation_fn "promote ${AUTH_FILE} -> ${ACTIVE_CREDENTIALS_FILE}" atomic_copy_json "${AUTH_FILE}" "${ACTIVE_CREDENTIALS_FILE}"
  elif [[ ! -f "${ACTIVE_CREDENTIALS_FILE}" ]]; then
    # Fresh with no existing credentials: create empty live credentials file.
    log_v "Creating empty live credentials file..."
    run_mutation_fn "create empty live credentials file ${ACTIVE_CREDENTIALS_FILE}" create_empty_profile_file "${ACTIVE_CREDENTIALS_FILE}"
  fi

  log_v "Pointing auth.json to live credentials file..."
  run_mutation "repoint auth symlink ${AUTH_FILE} -> ${ACTIVE_CREDENTIALS_FILE}" ln -sf "${ACTIVE_CREDENTIALS_FILE}" "${AUTH_FILE}"

  local active_profile=""
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  if [[ -f "${ACTIVE_CREDENTIALS_FILE}" ]] && "${jq_bin}" -e 'type=="object" and (keys|length) > 0' "${ACTIVE_CREDENTIALS_FILE}" >/dev/null 2>&1; then
    local default_profile_path="${PROFILES_DIR}/default.json"
    log_v "Creating default profile from current live credentials..."
    run_mutation_fn "copy ${ACTIVE_CREDENTIALS_FILE} -> ${default_profile_path}" atomic_copy_json "${ACTIVE_CREDENTIALS_FILE}" "${default_profile_path}"
    active_profile="default"
  fi
  run_mutation_fn "rebuild state with active profile '${active_profile}'" state_rebuild "${active_profile}"

  if [[ "${DRY_RUN}" == "true" ]]; then
    success "[DRY-RUN] init completed with no changes."
  elif [[ "${active_profile}" == "default" ]]; then
    success "initialized fresh layout (${TOOL_VERSION}) and created profile 'default' from current auth."
  else
    success "initialized fresh layout (${TOOL_VERSION})."
  fi
}

cmd_migrate() {
  local layout_state
  layout_state="$(detect_layout_state)"
  case "${layout_state}" in
    legacy)
      ;;
    fresh)
      die_with_code "${E_INIT_REQUIRED}" "fresh environment detected; run 'oc-profile init' first."
      ;;
    initialized)
      success "already on current layout; migration not required."
      return 0
      ;;
    *)
      die_with_code "${E_GENERIC}" "layout is inconsistent; cannot migrate safely."
      ;;
  esac

  log_v "Acquiring lock..."
  acquire_lock
  log_v "Ensuring profile directories exist..."
  ensure_dirs
  log_vv "  Auth dir: ${AUTH_DIR}"
  log_vv "  Profiles dir: ${PROFILES_DIR}"
  require_jq >/dev/null

  # Detect legacy active profile from the old direct symlink, before we change anything.
  log_v "Detecting legacy active profile..."
  local legacy_active=""
  if [[ -L "${AUTH_FILE}" ]]; then
    local resolved
    resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
    if [[ "${resolved}" == "${PROFILES_DIR}/"*".json" && "${resolved}" != "${ACTIVE_CREDENTIALS_FILE}" ]]; then
      legacy_active="$(basename "${resolved}" .json)"
    fi
  fi

  # One-time bootstrap backup — created only if the backup directory is empty.
  if [[ -z "$(ls -1 "${BOOTSTRAP_BACKUP_DIR}" 2>/dev/null | head -n 1 || true)" ]]; then
    log_v "Preparing bootstrap backup..."
    local source_file=""
    if [[ -L "${AUTH_FILE}" ]]; then
      local resolved
      resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
      if [[ "${resolved}" == "${ACTIVE_CREDENTIALS_FILE}" ]]; then
        source_file="${ACTIVE_CREDENTIALS_FILE}"
      elif [[ -f "${resolved}" ]]; then
        source_file="${resolved}"
      fi
    fi
    [[ -n "${source_file}" && -f "${source_file}" ]] \
      || die_with_code "${E_GENERIC}" "cannot locate auth.json target to back up before migration."

    local ts
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    local backup_path="${BOOTSTRAP_BACKUP_DIR}/${ts}_pre-migrate_auth.json"
    run_mutation_fn "copy bootstrap backup ${source_file} -> ${backup_path}" atomic_copy_json "${source_file}" "${backup_path}"

    if [[ "${DRY_RUN}" != "true" ]]; then
      local src_sha backup_sha
      src_sha="$(canonical_hash_file "${source_file}")"
      backup_sha="$(canonical_hash_file "${backup_path}")"
      [[ "${src_sha}" == "${backup_sha}" ]] \
        || die_with_code "${E_GENERIC}" "bootstrap backup verification failed."
    fi
  fi

  # Ensure the live credentials file exists.
  if [[ ! -f "${ACTIVE_CREDENTIALS_FILE}" ]]; then
    log_v "Ensuring live credentials file exists..."
    if [[ -L "${AUTH_FILE}" ]]; then
      local resolved
      resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
      [[ -f "${resolved}" ]] \
        || die_with_code "${E_GENERIC}" "auth.json does not point to a usable file for migration."
      run_mutation_fn "copy active credentials ${resolved} -> ${ACTIVE_CREDENTIALS_FILE}" atomic_copy_json "${resolved}" "${ACTIVE_CREDENTIALS_FILE}"
    else
      die_with_code "${E_GENERIC}" "auth.json must be a symlink for migration."
    fi
  fi

  # Repoint auth.json to the live credentials file.
  log_v "Updating auth.json symlink to live credentials..."
  run_mutation "repoint auth symlink ${AUTH_FILE} -> ${ACTIVE_CREDENTIALS_FILE}" ln -sf "${ACTIVE_CREDENTIALS_FILE}" "${AUTH_FILE}"

  # Derive active profile name and rebuild state.
  local active_profile="${legacy_active}"
  if [[ -z "${active_profile}" ]]; then
    active_profile="$(discover_active_profile)"
  fi

  run_mutation_fn "rebuild state with active profile '${active_profile}'" state_rebuild "${active_profile}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    success "[DRY-RUN] migrate completed with no changes."
  else
    success "migrated to current layout (${TOOL_VERSION}). Restart opencode to apply changes."
  fi
}

cmd_make() {
  local name=""
  local use_current=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --current) use_current=true; shift ;;
      -*) die_with_code "${E_GENERIC}" "unknown flag '$1'." ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "${name}" ]] || die_with_code "${E_GENERIC}" "usage: oc-profile make <name> [--current]"
  validate_profile_name "${name}"

  require_initialized_layout
  log_v "Acquiring lock..."
  acquire_lock
  require_jq >/dev/null
  ensure_dirs
  log_vv "  Target profile path: ${PROFILES_DIR}/${name}.json"

  if state_has_profile "${name}"; then
    die_with_code "${E_GENERIC}" "profile '${name}' already exists. Delete it first or choose another name."
  fi

  if [[ "${use_current}" == "true" ]]; then
    [[ -f "${ACTIVE_CREDENTIALS_FILE}" ]] \
      || die_with_code "${E_GENERIC}" "live credentials file not found (${ACTIVE_CREDENTIALS_FILE})."
    log_v "Creating profile '${name}' from current auth..."
    run_mutation_fn "copy ${ACTIVE_CREDENTIALS_FILE} -> ${PROFILES_DIR}/${name}.json" atomic_copy_json "${ACTIVE_CREDENTIALS_FILE}" "${PROFILES_DIR}/${name}.json"
    run_mutation_fn "rebuild state with active profile '${name}'" state_rebuild "${name}"
    if [[ "${DRY_RUN}" == "true" ]]; then
      success "[DRY-RUN] make '${name}' (--current) completed with no changes."
    else
      success "created profile '${name}' from current auth and set as active."
    fi
  else
    if ! state_has_any_profiles; then
      die_with_code "${E_GENERIC}" "first profile must be saved from current credentials. Run 'oc-profile make ${name} --current' first."
    fi
    log_v "Creating empty profile '${name}'..."
    local dest="${PROFILES_DIR}/${name}.json"
    run_mutation_fn "create empty profile file ${dest}" create_empty_profile_file "${dest}"
    local current_active
    current_active="$(state_active_profile)"
    run_mutation_fn "rebuild state with active profile '${current_active}'" state_rebuild "${current_active}"
    if [[ "${DRY_RUN}" == "true" ]]; then
      success "[DRY-RUN] make '${name}' completed with no changes."
    else
      success "created profile '${name}'."
    fi
  fi
}

cmd_switch() {
  local name=""
  local save_current=""
  local trust_mismatch=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --save-current)      save_current="yes"; shift ;;
      --no-save-current)   save_current="no";  shift ;;
      --trust-mismatch)    trust_mismatch="yes"; shift ;;
      --abort-on-mismatch) trust_mismatch="no";  shift ;;
      -*) die_with_code "${E_GENERIC}" "unknown flag '$1'." ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "${name}" ]] \
    || die_with_code "${E_GENERIC}" "usage: oc-profile switch <name> [--save-current|--no-save-current] [--trust-mismatch|--abort-on-mismatch]"
  validate_profile_name "${name}"

  require_initialized_layout
  log_v "Acquiring lock..."
  acquire_lock
  require_jq >/dev/null
  ensure_dirs

  state_has_profile "${name}" \
    || die_with_code "${E_GENERIC}" "profile '${name}' does not exist. Run 'oc-profile list' to see available profiles."

  # Capture target profile hash from state before any potential rebuild.
  local recorded_sha
  recorded_sha="$(state_profile_sha "${name}")"

  local current
  current="$(state_active_profile)"
  if [[ "${current}" == "${name}" ]]; then
    log_v "Already on profile '${name}'."
    info "already on profile '${name}'."
    return 0
  fi

  log_v "Switching to profile '${name}'..."
  log_vv "  Source profile: ${PROFILES_DIR}/${name}.json"
  log_vv "  Target live file: ${ACTIVE_CREDENTIALS_FILE}"

  local interactive
  is_interactive && interactive="yes" || interactive="no"

  # ── Dirty-active detection ───────────────────────────────
  # Only relevant when there is a known current profile whose credentials we could save.
  # If current is empty or its file is gone there is nothing to compare or save; skip.
  local live_sha saved_sha dirty=false
  if [[ -n "${current}" && -f "${PROFILES_DIR}/${current}.json" ]]; then
    live_sha="$(canonical_hash_file "${ACTIVE_CREDENTIALS_FILE}")"
    saved_sha="$(canonical_hash_file "${PROFILES_DIR}/${current}.json")"
    [[ "${live_sha}" == "${saved_sha}" ]] || dirty=true
  fi

  if [[ "${dirty}" == "true" ]]; then
    if [[ "${interactive}" != "yes" ]]; then
      [[ "${save_current}" == "yes" || "${save_current}" == "no" ]] \
        || die_with_code "${E_PROMPT_NONINT}" \
             "prompt required to handle dirty active credentials (non-interactive: pass --save-current or --no-save-current)."
    else
      if [[ "${save_current}" != "yes" && "${save_current}" != "no" ]]; then
        save_current="$(prompt_yes_no \
          "active credentials differ from saved '${current}'. Save current before switching?" "yes")"
      fi
    fi

    if [[ "${save_current}" == "yes" ]]; then
      [[ -n "${current}" ]] \
        || die_with_code "${E_GENERIC}" "cannot save dirty credentials: no active profile name in state."
      run_mutation_fn "save dirty active credentials ${ACTIVE_CREDENTIALS_FILE} -> ${PROFILES_DIR}/${current}.json" atomic_copy_json "${ACTIVE_CREDENTIALS_FILE}" "${PROFILES_DIR}/${current}.json"
      run_mutation_fn "rebuild state with active profile '${current}'" state_rebuild "${current}"
    fi
  fi

  # ── Hash mismatch detection for the target profile ───────
  local computed_sha
  computed_sha="$(canonical_hash_file "${PROFILES_DIR}/${name}.json")"

  if [[ -n "${recorded_sha}" && "${computed_sha}" != "${recorded_sha}" ]]; then
    if [[ "${interactive}" != "yes" ]]; then
      [[ "${trust_mismatch}" == "yes" ]] \
        || die_with_code "${E_HASH_MISMATCH}" \
             "hash mismatch refused (non-interactive: pass --trust-mismatch to proceed)."
    else
      if [[ "${trust_mismatch}" != "yes" && "${trust_mismatch}" != "no" ]]; then
        trust_mismatch="$(prompt_yes_no \
          "saved profile '${name}' hash differs from recorded state. Trust and update?" "yes")"
      fi
      [[ "${trust_mismatch}" == "yes" ]] \
        || die_with_code "${E_HASH_MISMATCH}" "hash mismatch refused."
    fi
    run_mutation_fn "rebuild state after trusting hash mismatch (active '${current}')" state_rebuild "${current}"
  fi

  # ── Apply switch ─────────────────────────────────────────
  run_mutation_fn "copy target profile ${PROFILES_DIR}/${name}.json -> ${ACTIVE_CREDENTIALS_FILE}" atomic_copy_json "${PROFILES_DIR}/${name}.json" "${ACTIVE_CREDENTIALS_FILE}"
  run_mutation_fn "rebuild state with active profile '${name}'" state_rebuild "${name}"

  if [[ "${DRY_RUN}" != "true" ]] && pgrep -x opencode >/dev/null 2>&1; then
    warn "warning: opencode appears to be running. Restart it to apply the switch."
  fi
  if [[ "${DRY_RUN}" == "true" ]]; then
    success "[DRY-RUN] switch to '${name}' completed with no changes."
  else
    success "switched to '${name}'. Restart opencode to apply."
  fi
}

cmd_list() {
  if state_is_valid; then
    local current
    current="$(state_active_profile)"
    local profiles=()
    mapfile -t profiles < <(state_list_profiles)

    if [[ ${#profiles[@]} -eq 0 ]]; then
      info "no profiles saved yet."
      if [[ -f "${ACTIVE_CREDENTIALS_FILE}" ]]; then
        info "run 'oc-profile make <name> --current' to save current live credentials as your first profile."
      fi
      echo ""
      return 0
    fi

    echo ""
    echo -e "${BOLD}Saved profiles:${RESET}"
    echo ""
    for p in "${profiles[@]}"; do
      if [[ "${p}" == "${current}" ]]; then
        echo -e "  ${GREEN}* ${p}${RESET} ${DIM}(active)${RESET}"
      else
        echo -e "    ${p}"
      fi
    done
    echo ""
    return 0
  fi

  info "no profiles saved yet."
  if [[ -f "${ACTIVE_CREDENTIALS_FILE}" ]]; then
    info "run 'oc-profile make <name> --current' to save current live credentials as your first profile."
  fi
  echo ""
}

cmd_which() {
  state_is_valid || die_with_code "${E_GENERIC}" "no active profile found. Run 'oc-profile make <name> --current' to save current live credentials first."
  local current
  current="$(state_active_profile)"
  [[ -n "${current}" ]] || die_with_code "${E_GENERIC}" "no active profile found. Run 'oc-profile make <name> --current' to save current live credentials first."
  echo "${current}"
}

cmd_delete() {
  local name="${1:-}"
  [[ -n "${name}" ]] || die_with_code "${E_GENERIC}" "usage: oc-profile delete <name>"
  validate_profile_name "${name}"

  require_initialized_layout
  log_v "Acquiring lock..."
  acquire_lock
  require_jq >/dev/null
  ensure_dirs

  state_has_profile "${name}" \
    || die_with_code "${E_GENERIC}" "profile '${name}' does not exist."

  local count
  count="$(state_list_profiles | wc -l | tr -d ' ')"
  [[ "${count}" -gt 1 ]] || die_with_code "${E_GENERIC}" "cannot delete the last profile."

  local current
  current="$(state_active_profile)"
  [[ "${current}" != "${name}" ]] \
    || die_with_code "${E_GENERIC}" "cannot delete the active profile. Switch to another profile first."

  local unknowns=""
  unknowns="$(profiles_unknown_files 2>/dev/null || true)"
  [[ -z "${unknowns}" ]] \
    || die_with_code "${E_GENERIC}" "unrecognized JSON file(s) in profiles directory:\n${unknowns}"

  run_mutation "remove profile file ${PROFILES_DIR}/${name}.json" rm -f "${PROFILES_DIR}/${name}.json"
  run_mutation_fn "rebuild state with active profile '${current}'" state_rebuild "${current}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    success "[DRY-RUN] delete '${name}' completed with no changes."
  else
    success "deleted profile '${name}'."
  fi
}

cmd_rename() {
  local old="${1:-}"
  local new="${2:-}"
  [[ -n "${old}" && -n "${new}" ]] || die_with_code "${E_GENERIC}" "usage: oc-profile rename <old> <new>"
  validate_profile_name "${old}"
  validate_profile_name "${new}"

  require_initialized_layout
  log_v "Acquiring lock..."
  acquire_lock
  require_jq >/dev/null

  state_has_profile "${old}" \
    || die_with_code "${E_GENERIC}" "profile '${old}' does not exist."
  ! state_has_profile "${new}" \
    || die_with_code "${E_GENERIC}" "profile '${new}' already exists."

  local current
  current="$(state_active_profile)"

  run_mutation "rename profile file ${PROFILES_DIR}/${old}.json -> ${PROFILES_DIR}/${new}.json" mv "${PROFILES_DIR}/${old}.json" "${PROFILES_DIR}/${new}.json"
  [[ "${current}" == "${old}" ]] && current="${new}"
  run_mutation_fn "rebuild state with active profile '${current}'" state_rebuild "${current}"
  if [[ "${DRY_RUN}" == "true" ]]; then
    success "[DRY-RUN] rename '${old}' -> '${new}' completed with no changes."
  else
    success "renamed '${old}' -> '${new}'."
  fi
}

# ── Main dispatch ──────────────────────────────────────────

DRY_RUN=false
VERBOSE=0

# Extract command first (first non-flag argument)
# Then parse remaining arguments as global flags
# This allows: ./oc-profile make work --dry-run
cmd=""
# Parse arguments: extract command and global flags
# Global flags can appear before OR after the command
remaining_args=()
cmd=""

for arg in "$@"; do
  # Check if this is a global flag
  case "${arg}" in
    --skip-checks) SKIP_CHECKS=true ;;
    --always-checks) SKIP_CHECKS=false ;;
    --dry-run) DRY_RUN=true ;;
    -v|--verbose) VERBOSE=$((VERBOSE + 1)) ;;
    -vv) VERBOSE=2 ;;
    -vvv) VERBOSE=3 ;;
    -v*)
      # Handle grouped verbose flags like -vvv and -vvvv.
      if [[ "${arg}" =~ ^-v+$ ]]; then
        VERBOSE=$((VERBOSE + ${#arg} - 1))
      else
        remaining_args+=("${arg}")
      fi
      ;;
    --help|-h) cmd_help; exit 0 ;;
    --version) cmd_version; exit 0 ;;
    --*)
      # Check if it's a known command-specific flag
      case "${arg}" in
        --current|--save-current|--no-save-current|--trust-mismatch|--abort-on-mismatch)
          # Command-specific flag - pass to command
          remaining_args+=("${arg}")
          ;;
        *)
          # Unknown long flag - error
          echo -e "${RED}error:${RESET} unknown flag '${arg}'" >&2
          exit 1
          ;;
      esac
      ;;
    -*)
      # Unknown short flag - pass to command (let command handle error)
      remaining_args+=("${arg}")
      ;;
    *)
      # Non-flag argument
      if [[ -z "${cmd}" ]]; then
        # First non-flag is the command
        cmd="${arg}"
      else
        # Additional non-flag args go to command
        remaining_args+=("${arg}")
      fi
      ;;
  esac
done

# If no command found, default to help
if [[ -z "${cmd}" ]]; then
  cmd="help"
fi

# Set $@ to remaining args for command
set -- "${remaining_args[@]}"

if [[ "${SKIP_CHECKS}" == "true" ]]; then
  warn "WARNING: --skip-checks is active. Runtime dependency checks (jq, flock) are bypassed."
fi

case "${cmd}" in
  init)              cmd_init "$@" ;;
  migrate)           cmd_migrate "$@" ;;
  make)              cmd_make "$@" ;;
  switch)            cmd_switch "$@" ;;
  list|ls)           cmd_list ;;
  which)             cmd_which ;;
  delete|rm)         cmd_delete "$@" ;;
  rename|mv)         cmd_rename "$@" ;;
  version|--version) cmd_version ;;
  help|--help|-h)    cmd_help ;;
  *) die "unknown command '${cmd}'. Run 'oc-profile help' for usage." ;;
esac
