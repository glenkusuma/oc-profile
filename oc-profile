#!/usr/bin/env bash
set -euo pipefail

# ── Global constants ───────────────────────────────────────

AUTH_DIR="${HOME}/.local/share/opencode"
AUTH_FILE="${AUTH_DIR}/auth.json"
PROFILES_DIR="${AUTH_DIR}/profiles"
ACTIVE_CREDENTIALS_FILE="${PROFILES_DIR}/auth.active.json"
BOOTSTRAP_BACKUP_DIR="${PROFILES_DIR}/.bootstrap-backup"
STATE_FILE="${AUTH_DIR}/oc-profile.json"
LOCK_FILE="${AUTH_DIR}/oc-profile.lock"
TOOL_VERSION="0.1.0-rc.1"

readonly USAGE_MAKE="usage: oc-profile make <name> [--current]"
readonly USAGE_SAVE="usage: oc-profile save <name> [--set-active]"
readonly USAGE_SWITCH="usage: oc-profile switch <name> [--save-current|--no-save-current] [--trust-mismatch|--abort-on-mismatch] [--allow-empty-target]"
readonly USAGE_LIST="usage: oc-profile list [--details|--detail|-a]"

# Canonical command registry
# Field order:
# 1 canonical | 2 aliases_csv | 3 local_flags_csv | 4 help_aliases_csv
# 5 requires_jq_skip | 6 requires_flock_skip | 7 capability_exempt | 8 mutating
# 9 help_fn | 10 dispatch_fn | 11 help_summary
readonly -a COMMAND_REGISTRY=(
  "init||||yes|yes|no|yes|help_init|cmd_init|init                             Initialize fresh layout for first-time setup"
  "migrate||||yes|yes|no|yes|help_migrate|cmd_migrate|migrate                          Migrate legacy installs to the current layout"
  "make||--current||yes|yes|no|yes|help_make|cmd_make|make <name> [--current]          Save current auth as a profile, or create a placeholder"
  "save||--set-active||yes|yes|no|yes|help_save|cmd_save|save <name> [--set-active]       Update an existing saved profile from current live auth"
  "switch||--save-current,--no-save-current,--trust-mismatch,--abort-on-mismatch,--allow-empty-target||yes|yes|no|yes|help_switch|cmd_switch|switch <name>                    Switch live auth to a saved profile (restart opencode)"
  "list|ls|--details,--detail,-a|ls|yes|no|no|no|help_list|cmd_list|list/ls                          List all profiles"
  "which||||yes|no|no|no|help_which|cmd_which|which                            Show the active profile name"
  "rename|mv||mv|yes|yes|no|yes|help_rename|cmd_rename|rename/mv <old> <new>            Rename a profile"
  "delete|rm||rm|yes|yes|no|yes|help_delete|cmd_delete|delete/rm <name>                 Delete a profile (not the last or active one)"
  "version|--version||--version|no|no|yes|no|help_version|cmd_version|version/--version                Print version"
  "help|--help,-h||help,--help,-h|no|no|yes|no||cmd_help|help/--help/-h                   Show this help"
)

# ── Exit codes ─────────────────────────────────────────────
# Deterministic exit codes; all mutating paths use these.
readonly E_GENERIC=1
readonly E_LEGACY=10       # legacy layout detected; run 'migrate'
readonly E_PROMPT_NONINT=11 # prompt required but session is non-interactive
readonly E_HASH_MISMATCH=12 # hash mismatch refused
readonly E_JQ_MISSING=13   # jq not found or unusable
readonly E_LOCK_BUSY=14    # lock already held by another process
readonly E_SKIP_CHECKS_BLOCKED=15  # capability unavailable in --skip-checks mode
readonly E_INIT_REQUIRED=16  # layout requires initialization

# ── Mode flags ──────────────────────────────────────────────
SKIP_CHECKS=false

if [[ "${OC_PROFILE_SKIP_CHECKS:-}" == "true" ]]; then
  SKIP_CHECKS=true
fi

# ── Colors ─────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Output helpers ─────────────────────────────────────────

die()           { echo -e "${RED}error:${RESET} $1" >&2; exit 1; }
die_with_code() { local code="$1"; shift; echo -e "${RED}error:${RESET} $*" >&2; exit "${code}"; }
info()          { echo -e "${CYAN}$1${RESET}"; }
success()       { echo -e "${GREEN}$1${RESET}"; }
warn()          { echo -e "${YELLOW}$1${RESET}"; }

die_unknown_flag() {
  local flag="$1"
  die_with_code "${E_GENERIC}" "unknown flag '${flag}'."
}

log_v() {
  [[ "${VERBOSE:-0}" -ge 1 ]] && info "$1"
  return 0
}

log_vv() {
  [[ "${VERBOSE:-0}" -ge 2 ]] && info "$1"
  return 0
}

run_mutation() {
  # $1 = descriptive label, remaining args = command + args
  local label="$1"
  shift
  if [[ "${DRY_RUN:-false}" == "true" ]]; then
    info "[DRY-RUN] ${label}"
    return 0
  fi
  "$@"
}

run_mutation_fn() {
  # $1 = descriptive label, $2 = function name, remaining args = function args
  local label="$1"
  local fn="$2"
  shift 2
  if [[ "${DRY_RUN:-false}" == "true" ]]; then
    info "[DRY-RUN] ${label}"
    return 0
  fi
  "${fn}" "$@"
}

# ── Low-level helpers ──────────────────────────────────────

is_interactive() {
  [[ -t 0 && -t 1 ]]
}

validate_profile_name() {
  local name="$1"
  if [[ -z "${name}" ]]; then
    die_with_code "${E_GENERIC}" "profile name cannot be empty."
  fi
  if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    die_with_code "${E_GENERIC}" "invalid profile name '${name}'. Use only letters, numbers, hyphens, and underscores."
  fi
}

ensure_dirs() {
  # umask-independent: create dirs with mode 700 regardless of the caller's umask.
  local old_umask
  old_umask="$(umask)"
  umask 077
  install -d -m 700 "${AUTH_DIR}" "${PROFILES_DIR}" "${BOOTSTRAP_BACKUP_DIR}"
  umask "${old_umask}"
}

resolve_symlink_target() {
  # Prints the absolute path that a symlink points to.  Returns 1 if not resolvable.
  local link_path="$1"
  local target
  target="$(readlink "${link_path}" 2>/dev/null || true)"
  [[ -n "${target}" ]] || return 1
  if [[ "${target}" = /* ]]; then
    printf '%s\n' "${target}"
  else
    printf '%s\n' "$(cd "$(dirname "${link_path}")" && pwd)/${target}"
  fi
}

atomic_copy_json() {
  # Atomically copy $1 -> $2 using a temp file in $2's directory, mode 600.
  local src="$1"
  local dest="$2"
  [[ -f "${src}" ]] || die_with_code "${E_GENERIC}" "atomic_copy_json: source file not found: ${src}"
  local dest_dir
  dest_dir="$(dirname "${dest}")"
  local tmp
  tmp="$(mktemp -p "${dest_dir}" .oc-profile.copy.XXXXXX)"
  chmod 600 "${tmp}" 2>/dev/null || true
  cp "${src}" "${tmp}"
  chmod 600 "${tmp}" 2>/dev/null || true
  mv -f "${tmp}" "${dest}"
  chmod 600 "${dest}" 2>/dev/null || true
}

create_empty_profile_file() {
  local dest="$1"
  local tmp
  tmp="$(mktemp -p "$(dirname "${dest}")" .oc-profile.make.XXXXXX)"
  chmod 600 "${tmp}" 2>/dev/null || true
  printf '{}\n' > "${tmp}"
  chmod 600 "${tmp}" 2>/dev/null || true
  mv -f "${tmp}" "${dest}"
  chmod 600 "${dest}" 2>/dev/null || true
}

backup_auth_file() {
  local src="$1"
  local ts
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  local backup_path="${BOOTSTRAP_BACKUP_DIR}/${ts}_pre-init_auth.json"
  atomic_copy_json "${src}" "${backup_path}"
}

acquire_lock() {
  if [[ "${SKIP_CHECKS}" == "true" ]]; then
    warn "skipping flock check (--skip-checks mode). Mutating operations without locking may cause race conditions."
    return 0
  fi
  # Acquires a global flock on LOCK_FILE; exits with E_LOCK_BUSY if already held.
  command -v flock >/dev/null 2>&1 \
    || die_with_code "${E_GENERIC}" "flock not found; cannot safely run mutating commands."

  ensure_dirs

  local old_umask
  old_umask="$(umask)"
  umask 077
  if [[ ! -e "${LOCK_FILE}" ]]; then
    : > "${LOCK_FILE}" 2>/dev/null || true
  fi
  chmod 600 "${LOCK_FILE}" 2>/dev/null || true
  umask "${old_umask}"

  exec 9>"${LOCK_FILE}"
  if ! flock -n 9; then
    die_with_code "${E_LOCK_BUSY}" "lock is busy; retry shortly."
  fi
}

prompt_yes_no() {
  # Prints "yes" or "no" to stdout.  $1=prompt text  $2=default ("yes" or "no")
  local prompt="$1"
  local default="$2"
  local suffix
  if [[ "${default}" == "yes" ]]; then
    suffix="[Y/n]"
  else
    suffix="[y/N]"
  fi
  printf '%s %s ' "${prompt}" "${suffix}" >&2
  local ans=""
  read -r ans || true
  ans="${ans,,}"
  if [[ -z "${ans}" ]]; then
    echo "${default}"
    return 0
  fi
  case "${ans}" in
    y|yes) echo "yes" ;;
    *)     echo "no"  ;;
  esac
}

# ── jq dependency ──────────────────────────────────────────

require_jq() {
  # Resolves and validates jq.  Prints the path to the usable binary.
  # Resolution order: OC_PROFILE_JQ env var, then PATH.
  local jq_bin=""
  if [[ -n "${OC_PROFILE_JQ:-}" && -x "${OC_PROFILE_JQ}" ]]; then
    jq_bin="${OC_PROFILE_JQ}"
  else
    jq_bin="$(command -v jq || true)"
  fi

  if [[ "${SKIP_CHECKS}" == "true" ]]; then
    if [[ -z "${jq_bin}" ]]; then
      warn "skipping jq check (--skip-checks mode): jq not found."
      echo "jq"
      return 0
    fi
    if ! "${jq_bin}" --version >/dev/null 2>&1; then
      warn "skipping jq check (--skip-checks mode): jq is not usable."
      echo "${jq_bin}"
      return 0
    fi
    echo "${jq_bin}"
    return 0
  fi

  if [[ -z "${jq_bin}" ]]; then
    die_with_code "${E_JQ_MISSING}" \
      "jq >= 1.8 is required but jq was not found. Install jq (Debian/Ubuntu: apt-get install jq, Arch: pacman -S jq, macOS: brew install jq) and retry."
  fi
  local jq_version
  jq_version="$("${jq_bin}" --version 2>/dev/null || true)"
  if [[ -z "${jq_version}" ]]; then
    die_with_code "${E_JQ_MISSING}" \
      "jq >= 1.8 is required but '${jq_bin}' is not usable. Install jq >= 1.8 and retry."
  fi

  local major minor
  if [[ "${jq_version}" =~ ^jq-([0-9]+)\.([0-9]+)(\.[0-9]+)?$ ]]; then
    major="${BASH_REMATCH[1]}"
    minor="${BASH_REMATCH[2]}"
  else
    die_with_code "${E_JQ_MISSING}" \
      "jq >= 1.8 is required but version output was unrecognized ('${jq_version}'). Install jq >= 1.8 and retry."
  fi

  if (( major < 1 || (major == 1 && minor < 8) )); then
    die_with_code "${E_JQ_MISSING}" \
      "jq >= 1.8 is required (found ${jq_version}). Install newer jq (Debian/Ubuntu: apt-get install jq, Arch: pacman -S jq, macOS: brew install jq) and retry."
  fi

  echo "${jq_bin}"
}

canonical_hash_file() {
  # Computes SHA-256 of the canonical JSON form of a file (keys sorted, compact, trailing newline).
  local file="$1"
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  [[ -f "${file}" ]] || die_with_code "${E_GENERIC}" "canonical_hash_file: file not found: ${file}"
  local canon
  canon="$("${jq_bin}" -S -c '.' "${file}")"
  printf '%s\n' "${canon}" | sha256sum | awk '{print $1}'
}

# ── State helpers ──────────────────────────────────────────

state_is_valid() {
  # Returns 0 if STATE_FILE exists and has the expected v0.1.0 schema shape.
  [[ -f "${STATE_FILE}" ]] || return 1
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  if "${jq_bin}" -e \
    '(.schema_version == 1) and (.cli_version|type=="string") and (.active_profile|type=="string") and (.profiles|type=="object")' \
    "${STATE_FILE}" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

state_active_profile() {
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  "${jq_bin}" -r '.active_profile // ""' "${STATE_FILE}" 2>/dev/null || true
}

state_has_profile() {
  local name="$1"
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  # shellcheck disable=SC2016
  if "${jq_bin}" -e --arg n "${name}" '.profiles[$n] != null' "${STATE_FILE}" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

state_has_any_profiles() {
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  if "${jq_bin}" -e '(.profiles|type=="object") and ((.profiles|length) > 0)' "${STATE_FILE}" >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

state_profile_sha() {
  local name="$1"
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  # shellcheck disable=SC2016
  "${jq_bin}" -r --arg n "${name}" '.profiles[$n].sha256 // empty' "${STATE_FILE}" 2>/dev/null || true
}

state_list_profiles() {
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."
  "${jq_bin}" -r '.profiles | keys[]' "${STATE_FILE}" 2>/dev/null | sort -u
}

state_rebuild() {
  # Rebuilds STATE_FILE from profiles/*.json on disk (excluding auth.active.json).
  # $1 = active profile name to record (may be empty string)
  local active_profile="$1"
  local updated_at
  updated_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."

  local profiles_json="{"
  local first=1
  shopt -s nullglob
  for f in "${PROFILES_DIR}"/*.json; do
    local base
    base="$(basename "${f}" .json)"
    [[ "${base}" == "auth.active" ]] && continue
    [[ -f "${f}" ]] || continue
    validate_profile_name "${base}"

    local sha
    sha="$(canonical_hash_file "${f}")"
    [[ ${first} -eq 0 ]] && profiles_json+=","
    first=0
    profiles_json+="\"${base}\":{\"path\":\"profiles/${base}.json\",\"sha256\":\"${sha}\",\"updated_at\":\"${updated_at}\"}"
  done
  shopt -u nullglob
  profiles_json+="}"

  local tmp
  tmp="$(mktemp -p "${AUTH_DIR}" .oc-profile.state.XXXXXX)"
  chmod 600 "${tmp}" 2>/dev/null || true
  {
    printf '{'
    printf '"schema_version":1,'
    printf '"cli_version":"%s",' "${TOOL_VERSION}"
    printf '"active_profile":"%s",' "${active_profile}"
    printf '"profiles":%s' "${profiles_json}"
    printf '}\n'
  } > "${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
  chmod 600 "${STATE_FILE}" 2>/dev/null || true
}

profiles_unknown_files() {
  # Prints any *.json files in PROFILES_DIR that are not recorded in STATE_FILE.
  # Returns 1 if any unknowns exist.
  [[ -f "${STATE_FILE}" ]] || return 0

  local recognized
  recognized="$(state_list_profiles | tr '\n' ' ')"

  local unknown=()
  shopt -s nullglob
  for f in "${PROFILES_DIR}"/*.json; do
    local base
    base="$(basename "${f}" .json)"
    [[ "${base}" == "auth.active" ]] && continue
    if ! echo " ${recognized} " | grep -q " ${base} "; then
      unknown+=("$(basename "${f}")")
    fi
  done
  shopt -u nullglob

  if [[ ${#unknown[@]} -gt 0 ]]; then
    printf '%s\n' "${unknown[@]}"
    return 1
  fi
  return 0
}

# ── Layout / migration helpers ─────────────────────────────

detect_layout_state() {
  # Returns one of: initialized, legacy, fresh, broken
  local state_valid=false
  local auth_exists=false
  local auth_is_symlink=false
  local auth_target=""
  local active_exists=false

  if state_is_valid; then
    state_valid=true
  fi

  if [[ -e "${AUTH_FILE}" || -L "${AUTH_FILE}" ]]; then
    auth_exists=true
  fi
  if [[ -L "${AUTH_FILE}" ]]; then
    auth_is_symlink=true
    auth_target="$(resolve_symlink_target "${AUTH_FILE}" || true)"
  fi
  if [[ -f "${ACTIVE_CREDENTIALS_FILE}" ]]; then
    active_exists=true
  fi

  # Fully initialized expected layout.
  if [[ "${state_valid}" == "true" \
        && "${auth_is_symlink}" == "true" \
        && "${auth_target}" == "${ACTIVE_CREDENTIALS_FILE}" \
        && "${active_exists}" == "true" ]]; then
    echo "initialized"
    return 0
  fi

  # Known legacy marker: auth.json points directly to a saved profile.
  if [[ "${auth_is_symlink}" == "true" \
        && "${auth_target}" == "${PROFILES_DIR}/"*.json \
        && "${auth_target}" != "${ACTIVE_CREDENTIALS_FILE}" ]]; then
    echo "legacy"
    return 0
  fi

  # Fresh environments: no valid state and no legacy markers.
  if [[ "${state_valid}" != "true" ]]; then
    if [[ "${auth_is_symlink}" == "true" ]]; then
      # auth.json already points to active path but state is missing/invalid.
      if [[ "${auth_target}" == "${ACTIVE_CREDENTIALS_FILE}" ]]; then
        echo "fresh"
        return 0
      fi
      # Unknown symlink target is not safe to auto-classify.
      echo "broken"
      return 0
    fi
    # No auth or plain auth file: first-run initialization path.
    if [[ "${auth_exists}" == "false" || -f "${AUTH_FILE}" ]]; then
      echo "fresh"
      return 0
    fi
  fi

  # Any other state should be treated as broken and requires operator action.
  echo "broken"
}

require_initialized_layout() {
  local layout_state
  layout_state="$(detect_layout_state)"
  case "${layout_state}" in
    initialized) return 0 ;;
    legacy) die_with_code "${E_LEGACY}" "legacy layout detected; run 'oc-profile migrate' first." ;;
    fresh) die_with_code "${E_INIT_REQUIRED}" "fresh environment detected; run 'oc-profile init' first." ;;
    *) die_with_code "${E_GENERIC}" "layout is inconsistent; fix auth/state files or run 'oc-profile init' on a fresh setup." ;;
  esac
}

discover_active_profile() {
  # Tries to find which saved profile matches the live credentials by hash.
  local live_sha
  live_sha="$(canonical_hash_file "${ACTIVE_CREDENTIALS_FILE}")"
  shopt -s nullglob
  for f in "${PROFILES_DIR}"/*.json; do
    local base
    base="$(basename "${f}" .json)"
    [[ "${base}" == "auth.active" ]] && continue
    [[ -f "${f}" ]] || continue
    local sha
    sha="$(canonical_hash_file "${f}")"
    if [[ "${sha}" == "${live_sha}" ]]; then
      echo "${base}"
      shopt -u nullglob
      return 0
    fi
  done
  shopt -u nullglob
  echo ""
}

format_file_mtime_utc() {
  local file="$1"
  local ts
  ts="$(stat -c '%Y' "${file}" 2>/dev/null || stat -f '%m' "${file}" 2>/dev/null || true)"
  if [[ -z "${ts}" ]]; then
    echo "<unknown>"
    return 0
  fi
  date -u -d "@${ts}" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u -r "${ts}" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "<unknown>"
}

profile_details_summary() {
  local profile_name="$1"
  local profile_path="${PROFILES_DIR}/${profile_name}.json"
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -n "${jq_bin}" ]] || die_with_code "${E_JQ_MISSING}" "jq >= 1.8 is required. Install jq and retry."

  local mtime
  mtime="$(format_file_mtime_utc "${profile_path}")"

  if ! "${jq_bin}" -e . "${profile_path}" >/dev/null 2>&1; then
    printf 'hash=<invalid> mtime=%s providers=<invalid-json>' "${mtime}"
    return 0
  fi

  local hash12
  hash12="$(canonical_hash_file "${profile_path}" | cut -c1-12)"

  local provider_count
  provider_count="$("${jq_bin}" -r 'if type=="object" then (keys|length) else 0 end' "${profile_path}" 2>/dev/null || echo 0)"
  local provider_keys
  provider_keys="$("${jq_bin}" -r 'if type=="object" then (keys|sort|join(",")) else "<non-object>" end' "${profile_path}" 2>/dev/null || echo "<invalid-json>")"

  printf 'hash=%s mtime=%s providers=%s[%s]' "${hash12}" "${mtime}" "${provider_count}" "${provider_keys}"
}

# ── Commands ───────────────────────────────────────────────

cmd_version() {
  echo "${TOOL_VERSION}"
}

normalize_help_topic() {
  local topic="${1:-}"
  [[ -n "${topic}" ]] || topic="help"

  local canonical aliases_csv _local_flags_csv help_aliases_csv
  local _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn _help_summary
  for row in "${COMMAND_REGISTRY[@]}"; do
    IFS='|' read -r canonical aliases_csv _local_flags_csv help_aliases_csv \
      _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn _help_summary <<< "${row}"
    if [[ "${topic}" == "${canonical}" ]]; then
      echo "${canonical}"
      return 0
    fi
    csv_contains "${topic}" "${help_aliases_csv}" && {
      echo "${canonical}"
      return 0
    }
  done

  echo "${topic}"
}

normalize_command_token() {
  local token="${1:-}"

  local canonical aliases_csv
  local _local_flags_csv _help_aliases_csv _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn _help_summary
  for row in "${COMMAND_REGISTRY[@]}"; do
    IFS='|' read -r canonical aliases_csv _local_flags_csv _help_aliases_csv \
      _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn _help_summary <<< "${row}"
    if [[ "${token}" == "${canonical}" ]]; then
      echo "${canonical}"
      return 0
    fi
    csv_contains "${token}" "${aliases_csv}" && {
      echo "${canonical}"
      return 0
    }
  done

  echo "${token}"
}

is_command_token() {
  local token
  token="$(normalize_command_token "${1:-}")"
  command_registry_has "${token}"
}

flag_in_set() {
  local needle="${1:-}"
  shift
  local candidate
  for candidate in "$@"; do
    if [[ "${needle}" == "${candidate}" ]]; then
      return 0
    fi
  done
  return 1
}

csv_contains() {
  local needle="${1:-}"
  local csv="${2:-}"
  [[ -n "${csv}" ]] || return 1

  local IFS=','
  local candidate
  read -r -a csv_items <<< "${csv}"
  for candidate in "${csv_items[@]}"; do
    if [[ "${needle}" == "${candidate}" ]]; then
      return 0
    fi
  done
  return 1
}

command_registry_has() {
  local cmd="${1:-}"

  local canonical
  local _aliases_csv _local_flags_csv _help_aliases_csv _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn _help_summary
  for row in "${COMMAND_REGISTRY[@]}"; do
    IFS='|' read -r canonical _aliases_csv _local_flags_csv _help_aliases_csv \
      _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn _help_summary <<< "${row}"
    if [[ "${cmd}" == "${canonical}" ]]; then
      return 0
    fi
  done
  return 1
}

command_registry_field_by_index() {
  local cmd="${1:-}"
  local idx="${2:-}"

  local canonical aliases_csv local_flags_csv help_aliases_csv
  local requires_jq requires_flock capability_exempt mutating help_fn dispatch_fn help_summary
  for row in "${COMMAND_REGISTRY[@]}"; do
    IFS='|' read -r canonical aliases_csv local_flags_csv help_aliases_csv \
      requires_jq requires_flock capability_exempt mutating help_fn dispatch_fn help_summary <<< "${row}"
    if [[ "${cmd}" == "${canonical}" ]]; then
      case "${idx}" in
        1) echo "${canonical}" ;;
        2) echo "${aliases_csv}" ;;
        3) echo "${local_flags_csv}" ;;
        4) echo "${help_aliases_csv}" ;;
        5) echo "${requires_jq}" ;;
        6) echo "${requires_flock}" ;;
        7) echo "${capability_exempt}" ;;
        8) echo "${mutating}" ;;
        9) echo "${help_fn}" ;;
        10) echo "${dispatch_fn}" ;;
        11) echo "${help_summary}" ;;
        *) return 1 ;;
      esac
      return 0
    fi
  done
  return 1
}

join_flags_csv() {
  local first=1
  local item
  for item in "$@"; do
    if [[ ${first} -eq 1 ]]; then
      printf '%s' "${item}"
      first=0
    else
      printf ', %s' "${item}"
    fi
  done
}

join_flags_csv_string() {
  local csv="${1:-}"
  [[ -n "${csv}" ]] || return 0

  local IFS=','
  read -r -a csv_items <<< "${csv}"
  join_flags_csv "${csv_items[@]}"
}

has_usable_jq() {
  local jq_bin=""
  if [[ -n "${OC_PROFILE_JQ:-}" && -x "${OC_PROFILE_JQ}" ]]; then
    jq_bin="${OC_PROFILE_JQ}"
  else
    jq_bin="$(command -v jq || true)"
  fi
  [[ -n "${jq_bin}" ]] || return 1
  "${jq_bin}" --version >/dev/null 2>&1
}

has_flock_binary() {
  command -v flock >/dev/null 2>&1
}

command_is_capability_exempt() {
  local cmd="${1:-}"
  [[ "$(command_registry_field_by_index "${cmd}" 7 2>/dev/null || true)" == "yes" ]]
}

command_requires_jq_in_skip_mode() {
  local cmd="${1:-}"
  [[ "$(command_registry_field_by_index "${cmd}" 5 2>/dev/null || true)" == "yes" ]]
}

command_requires_flock_in_skip_mode() {
  local cmd="${1:-}"
  [[ "$(command_registry_field_by_index "${cmd}" 6 2>/dev/null || true)" == "yes" ]]
}

command_local_flags_csv() {
  local cmd="${1:-}"
  command_registry_field_by_index "${cmd}" 3
}

command_dispatch_fn() {
  local cmd="${1:-}"
  command_registry_field_by_index "${cmd}" 10
}

command_help_fn() {
  local topic="${1:-}"
  local canonical
  canonical="$(normalize_help_topic "${topic}")"
  command_registry_field_by_index "${canonical}" 9 2>/dev/null || true
}

render_command_help_summaries() {
  local canonical
  local _aliases_csv _local_flags_csv _help_aliases_csv _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn help_summary
  for row in "${COMMAND_REGISTRY[@]}"; do
    IFS='|' read -r canonical _aliases_csv _local_flags_csv _help_aliases_csv \
      _requires_jq _requires_flock _capability_exempt _mutating _help_fn _dispatch_fn help_summary <<< "${row}"
    echo "  ${help_summary}"
  done
}

require_skip_mode_capabilities_for_command() {
  local cmd="${1:-}"
  command_is_capability_exempt "${cmd}" && return 0

  local missing_jq="no"
  local missing_flock="no"

  if command_requires_jq_in_skip_mode "${cmd}"; then
    has_usable_jq || missing_jq="yes"
  fi

  if command_requires_flock_in_skip_mode "${cmd}"; then
    has_flock_binary || missing_flock="yes"
  fi

  if [[ "${missing_jq}" == "yes" && "${missing_flock}" == "yes" ]]; then
    die_with_code "${E_SKIP_CHECKS_BLOCKED}" \
      "operation '${cmd}' requires jq and flock in --skip-checks mode; rerun without --skip-checks (or pass --always-checks)."
  fi

  if [[ "${missing_jq}" == "yes" ]]; then
    die_with_code "${E_SKIP_CHECKS_BLOCKED}" \
      "operation '${cmd}' requires jq in --skip-checks mode; rerun without --skip-checks (or pass --always-checks)."
  fi

  if [[ "${missing_flock}" == "yes" ]]; then
    die_with_code "${E_SKIP_CHECKS_BLOCKED}" \
      "operation '${cmd}' requires flock in --skip-checks mode; rerun without --skip-checks (or pass --always-checks)."
  fi
}

flag_is_local_for_command() {
  local cmd="${1:-}"
  local flag="${2:-}"
  local local_flags_csv
  local_flags_csv="$(command_local_flags_csv "${cmd}" 2>/dev/null || true)"
  csv_contains "${flag}" "${local_flags_csv}"
}

