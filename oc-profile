#!/usr/bin/env bash
set -euo pipefail

# ── Global constants ───────────────────────────────────────

AUTH_DIR="${HOME}/.local/share/opencode"
AUTH_FILE="${AUTH_DIR}/auth.json"
PROFILES_DIR="${AUTH_DIR}/profiles"
ACTIVE_CREDENTIALS_FILE="${PROFILES_DIR}/auth.active.json"
BOOTSTRAP_BACKUP_DIR="${PROFILES_DIR}/.bootstrap-backup"
STATE_FILE="${AUTH_DIR}/oc-profile.json"
LOCK_FILE="${AUTH_DIR}/oc-profile.lock"
TOOL_VERSION="0.1.0"

# ── Exit codes ─────────────────────────────────────────────
# Deterministic exit codes; all mutating paths use these.
readonly E_OK=0
readonly E_GENERIC=1
readonly E_LEGACY=10       # legacy layout detected; run 'migrate'
readonly E_PROMPT_NONINT=11 # prompt required but session is non-interactive
readonly E_HASH_MISMATCH=12 # hash mismatch refused
readonly E_JQ_MISSING=13   # jq not found or unusable
readonly E_LOCK_BUSY=14    # lock already held by another process

# ── Colors ─────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Output helpers ─────────────────────────────────────────

die()           { echo -e "${RED}error:${RESET} $1" >&2; exit 1; }
die_with_code() { local code="$1"; shift; echo -e "${RED}error:${RESET} $*" >&2; exit "${code}"; }
info()          { echo -e "${CYAN}$1${RESET}"; }
success()       { echo -e "${GREEN}$1${RESET}"; }
warn()          { echo -e "${YELLOW}$1${RESET}"; }

# ── Low-level helpers ──────────────────────────────────────

is_interactive() {
  [[ -t 0 && -t 1 ]]
}

validate_profile_name() {
  local name="$1"
  if [[ -z "${name}" ]]; then
    die_with_code "${E_GENERIC}" "profile name cannot be empty."
  fi
  if [[ ! "${name}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    die_with_code "${E_GENERIC}" "invalid profile name '${name}'. Use only letters, numbers, hyphens, and underscores."
  fi
}

ensure_dirs() {
  # umask-independent: create dirs with mode 700 regardless of the caller's umask.
  local old_umask
  old_umask="$(umask)"
  umask 077
  install -d -m 700 "${AUTH_DIR}" "${PROFILES_DIR}" "${BOOTSTRAP_BACKUP_DIR}"
  umask "${old_umask}"
}

resolve_symlink_target() {
  # Prints the absolute path that a symlink points to.  Returns 1 if not resolvable.
  local link_path="$1"
  local target
  target="$(readlink "${link_path}" 2>/dev/null || true)"
  [[ -n "${target}" ]] || return 1
  if [[ "${target}" = /* ]]; then
    printf '%s\n' "${target}"
  else
    printf '%s\n' "$(cd "$(dirname "${link_path}")" && pwd)/${target}"
  fi
}

atomic_copy_json() {
  # Atomically copy $1 -> $2 using a temp file in $2's directory, mode 600.
  local src="$1"
  local dest="$2"
  [[ -f "${src}" ]] || die_with_code "${E_GENERIC}" "atomic_copy_json: source file not found: ${src}"
  local dest_dir
  dest_dir="$(dirname "${dest}")"
  local tmp
  tmp="$(mktemp -p "${dest_dir}" .oc-profile.copy.XXXXXX)"
  chmod 600 "${tmp}" 2>/dev/null || true
  cp "${src}" "${tmp}"
  chmod 600 "${tmp}" 2>/dev/null || true
  mv -f "${tmp}" "${dest}"
  chmod 600 "${dest}" 2>/dev/null || true
}

acquire_lock() {
  # Acquires a global flock on LOCK_FILE; exits with E_LOCK_BUSY if already held.
  command -v flock >/dev/null 2>&1 \
    || die_with_code "${E_GENERIC}" "flock not found; cannot safely run mutating commands."

  ensure_dirs

  local old_umask
  old_umask="$(umask)"
  umask 077
  if [[ ! -e "${LOCK_FILE}" ]]; then
    : > "${LOCK_FILE}" 2>/dev/null || true
  fi
  chmod 600 "${LOCK_FILE}" 2>/dev/null || true
  umask "${old_umask}"

  exec 9>"${LOCK_FILE}"
  if ! flock -n 9; then
    die_with_code "${E_LOCK_BUSY}" "lock is busy; retry shortly."
  fi
}

prompt_yes_no() {
  # Prints "yes" or "no" to stdout.  $1=prompt text  $2=default ("yes" or "no")
  local prompt="$1"
  local default="$2"
  local suffix
  if [[ "${default}" == "yes" ]]; then
    suffix="[Y/n]"
  else
    suffix="[y/N]"
  fi
  printf '%s %s ' "${prompt}" "${suffix}" >&2
  local ans=""
  read -r ans || true
  ans="${ans,,}"
  if [[ -z "${ans}" ]]; then
    echo "${default}"
    return 0
  fi
  case "${ans}" in
    y|yes) echo "yes" ;;
    *)     echo "no"  ;;
  esac
}

# ── jq dependency ──────────────────────────────────────────

require_jq() {
  # Resolves and validates jq.  Prints the path to the usable binary.
  # Resolution order: OC_PROFILE_JQ env var, then PATH.
  local jq_bin=""
  if [[ -n "${OC_PROFILE_JQ:-}" && -x "${OC_PROFILE_JQ}" ]]; then
    jq_bin="${OC_PROFILE_JQ}"
  else
    jq_bin="$(command -v jq || true)"
  fi

  if [[ -z "${jq_bin}" ]]; then
    die_with_code "${E_JQ_MISSING}" \
      "jq is required but not found. Install jq >= 1.6 (https://jqlang.org/) and retry."
  fi
  if ! "${jq_bin}" --version >/dev/null 2>&1; then
    die_with_code "${E_JQ_MISSING}" \
      "jq is not usable. Ensure jq is installed and accessible in PATH."
  fi
  echo "${jq_bin}"
}

canonical_hash_file() {
  # Computes SHA-256 of the canonical JSON form of a file (keys sorted, compact, trailing newline).
  local file="$1"
  local jq_bin
  jq_bin="$(require_jq)"
  [[ -f "${file}" ]] || die_with_code "${E_GENERIC}" "canonical_hash_file: file not found: ${file}"
  local canon
  canon="$("${jq_bin}" -S -c '.' "${file}")"
  printf '%s\n' "${canon}" | sha256sum | awk '{print $1}'
}

# ── State helpers ──────────────────────────────────────────

state_is_valid() {
  # Returns 0 if STATE_FILE exists and has the expected v0.1.0 schema shape.
  [[ -f "${STATE_FILE}" ]] || return 1
  local jq_bin
  jq_bin="$(require_jq)"
  "${jq_bin}" -e \
    '(.schema_version == 1) and (.cli_version|type=="string") and (.active_profile|type=="string") and (.profiles|type=="object")' \
    "${STATE_FILE}" >/dev/null 2>&1
}

state_active_profile() {
  local jq_bin
  jq_bin="$(require_jq)"
  "${jq_bin}" -r '.active_profile // ""' "${STATE_FILE}" 2>/dev/null || true
}

state_has_profile() {
  local name="$1"
  local jq_bin
  jq_bin="$(require_jq)"
  "${jq_bin}" -e --arg n "${name}" '.profiles[$n] != null' "${STATE_FILE}" >/dev/null 2>&1
}

state_profile_sha() {
  local name="$1"
  local jq_bin
  jq_bin="$(require_jq)"
  "${jq_bin}" -r --arg n "${name}" '.profiles[$n].sha256 // empty' "${STATE_FILE}" 2>/dev/null || true
}

state_list_profiles() {
  local jq_bin
  jq_bin="$(require_jq)"
  "${jq_bin}" -r '.profiles | keys[]' "${STATE_FILE}" 2>/dev/null | sort -u
}

state_rebuild() {
  # Rebuilds STATE_FILE from profiles/*.json on disk (excluding auth.active.json).
  # $1 = active profile name to record (may be empty string)
  local active_profile="$1"
  local updated_at
  updated_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  local profiles_json="{"
  local first=1
  shopt -s nullglob
  for f in "${PROFILES_DIR}"/*.json; do
    local base
    base="$(basename "${f}" .json)"
    [[ "${base}" == "auth.active" ]] && continue
    [[ -f "${f}" ]] || continue
    validate_profile_name "${base}"

    local sha
    sha="$(canonical_hash_file "${f}")"
    [[ ${first} -eq 0 ]] && profiles_json+=","
    first=0
    profiles_json+="\"${base}\":{\"path\":\"profiles/${base}.json\",\"sha256\":\"${sha}\",\"updated_at\":\"${updated_at}\"}"
  done
  shopt -u nullglob
  profiles_json+="}"

  local tmp
  tmp="$(mktemp -p "${AUTH_DIR}" .oc-profile.state.XXXXXX)"
  chmod 600 "${tmp}" 2>/dev/null || true
  {
    printf '{'
    printf '"schema_version":1,'
    printf '"cli_version":"%s",' "${TOOL_VERSION}"
    printf '"active_profile":"%s",' "${active_profile}"
    printf '"profiles":%s' "${profiles_json}"
    printf '}\n'
  } > "${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
  chmod 600 "${STATE_FILE}" 2>/dev/null || true
}

profiles_unknown_files() {
  # Prints any *.json files in PROFILES_DIR that are not recorded in STATE_FILE.
  # Returns 1 if any unknowns exist.
  [[ -f "${STATE_FILE}" ]] || return 0

  local recognized
  recognized="$(state_list_profiles | tr '\n' ' ')"

  local unknown=()
  shopt -s nullglob
  for f in "${PROFILES_DIR}"/*.json; do
    local base
    base="$(basename "${f}" .json)"
    [[ "${base}" == "auth.active" ]] && continue
    if ! echo " ${recognized} " | grep -q " ${base} "; then
      unknown+=("$(basename "${f}")")
    fi
  done
  shopt -u nullglob

  if [[ ${#unknown[@]} -gt 0 ]]; then
    printf '%s\n' "${unknown[@]}"
    return 1
  fi
  return 0
}

# ── Layout / migration helpers ─────────────────────────────

layout_is_legacy() {
  # Returns 0 (true) when the on-disk layout requires migration.
  # Legacy conditions:
  #   - STATE_FILE missing or invalid schema, OR
  #   - auth.json does not symlink to profiles/auth.active.json
  if ! state_is_valid; then
    return 0
  fi
  if [[ ! -L "${AUTH_FILE}" ]]; then
    return 0
  fi
  local resolved
  resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
  [[ -n "${resolved}" ]] || return 0
  # Return 0 (legacy) only when the symlink does NOT point to ACTIVE_CREDENTIALS_FILE.
  [[ "${resolved}" != "${ACTIVE_CREDENTIALS_FILE}" ]]
}

require_migrated_layout() {
  # Call at the start of every mutating command.
  # Uses an explicit if so set -e is never triggered by the layout check itself.
  if layout_is_legacy; then
    die_with_code "${E_LEGACY}" "legacy layout detected; run 'opencode-profile migrate' first."
  fi
}

discover_active_profile() {
  # Tries to find which saved profile matches the live credentials by hash.
  local live_sha
  live_sha="$(canonical_hash_file "${ACTIVE_CREDENTIALS_FILE}")"
  shopt -s nullglob
  for f in "${PROFILES_DIR}"/*.json; do
    local base
    base="$(basename "${f}" .json)"
    [[ "${base}" == "auth.active" ]] && continue
    [[ -f "${f}" ]] || continue
    local sha
    sha="$(canonical_hash_file "${f}")"
    if [[ "${sha}" == "${live_sha}" ]]; then
      echo "${base}"
      shopt -u nullglob
      return 0
    fi
  done
  shopt -u nullglob
  echo ""
}

# ── Commands ───────────────────────────────────────────────

cmd_version() {
  echo "${TOOL_VERSION}"
}

cmd_help() {
  echo ""
  echo -e "${BOLD}opencode-profile${RESET} — manage OpenAI auth profiles for OpenCode"
  echo ""
  echo -e "${BOLD}USAGE${RESET}"
  echo "  opencode-profile <command> [args]"
  echo ""
  echo -e "${BOLD}COMMANDS${RESET}"
  echo "  migrate                          Migrate legacy installs to the current layout"
  echo "  make <name> [--current]          Save current auth as a profile, or create a placeholder"
  echo "  switch <name>                    Switch live auth to a saved profile (restart opencode)"
  echo "  list|ls                          List all profiles"
  echo "  which                            Show the active profile name"
  echo "  rename|mv <old> <new>            Rename a profile"
  echo "  delete|rm <name>                 Delete a profile (not the last or active one)"
  echo "  version|--version                Print version"
  echo "  help|--help|-h                   Show this help"
  echo ""
  echo -e "${BOLD}EXIT CODES${RESET}"
  echo "  0  success"
  echo "  10 legacy layout detected — run 'migrate'"
  echo "  11 prompt required but session is non-interactive"
  echo "  12 hash mismatch refused"
  echo "  13 jq missing or unusable"
  echo "  14 lock busy"
  echo ""
  echo -e "${BOLD}SETUP${RESET}"
  echo "  1. /connect in opencode with account A"
  echo "  2. opencode-profile make work --current"
  echo "  3. opencode-profile make personal"
  echo "  4. opencode-profile switch personal"
  echo "  5. restart opencode"
  echo "  6. /connect in opencode with account B"
  echo "  7. opencode-profile make personal --current"
  echo ""
  echo -e "${BOLD}FILES${RESET}"
  echo "  ${AUTH_FILE}              (symlink -> profiles/auth.active.json)"
  echo "  ${ACTIVE_CREDENTIALS_FILE}  (live credentials; OpenCode refreshes this)"
  echo "  ${PROFILES_DIR}/<name>.json  (saved profiles)"
  echo "  ${STATE_FILE}             (tool state + integrity hashes)"
  echo ""
}

cmd_migrate() {
  acquire_lock
  ensure_dirs
  require_jq >/dev/null

  # Detect legacy active profile from the old direct symlink, before we change anything.
  local legacy_active=""
  if [[ -L "${AUTH_FILE}" ]]; then
    local resolved
    resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
    if [[ "${resolved}" == "${PROFILES_DIR}/"*".json" && "${resolved}" != "${ACTIVE_CREDENTIALS_FILE}" ]]; then
      legacy_active="$(basename "${resolved}" .json)"
    fi
  fi

  # One-time bootstrap backup — created only if the backup directory is empty.
  if [[ -z "$(ls -1 "${BOOTSTRAP_BACKUP_DIR}" 2>/dev/null | head -n 1 || true)" ]]; then
    local source_file=""
    if [[ -L "${AUTH_FILE}" ]]; then
      local resolved
      resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
      if [[ "${resolved}" == "${ACTIVE_CREDENTIALS_FILE}" ]]; then
        source_file="${ACTIVE_CREDENTIALS_FILE}"
      elif [[ -f "${resolved}" ]]; then
        source_file="${resolved}"
      fi
    fi
    [[ -n "${source_file}" && -f "${source_file}" ]] \
      || die_with_code "${E_GENERIC}" "cannot locate auth.json target to back up before migration."

    local ts
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    local backup_path="${BOOTSTRAP_BACKUP_DIR}/${ts}_pre-migrate_auth.json"
    atomic_copy_json "${source_file}" "${backup_path}"

    local src_sha backup_sha
    src_sha="$(canonical_hash_file "${source_file}")"
    backup_sha="$(canonical_hash_file "${backup_path}")"
    [[ "${src_sha}" == "${backup_sha}" ]] \
      || die_with_code "${E_GENERIC}" "bootstrap backup verification failed."
  fi

  # Ensure the live credentials file exists.
  if [[ ! -f "${ACTIVE_CREDENTIALS_FILE}" ]]; then
    if [[ -L "${AUTH_FILE}" ]]; then
      local resolved
      resolved="$(resolve_symlink_target "${AUTH_FILE}" || true)"
      [[ -f "${resolved}" ]] \
        || die_with_code "${E_GENERIC}" "auth.json does not point to a usable file for migration."
      atomic_copy_json "${resolved}" "${ACTIVE_CREDENTIALS_FILE}"
    else
      die_with_code "${E_GENERIC}" "auth.json must be a symlink for migration."
    fi
  fi

  # Repoint auth.json to the live credentials file.
  ln -sf "${ACTIVE_CREDENTIALS_FILE}" "${AUTH_FILE}"

  # Derive active profile name and rebuild state.
  local active_profile="${legacy_active}"
  if [[ -z "${active_profile}" ]]; then
    active_profile="$(discover_active_profile)"
  fi

  state_rebuild "${active_profile}"
  success "migrated to current layout (${TOOL_VERSION}). Restart opencode to apply changes."
}

cmd_make() {
  require_migrated_layout
  acquire_lock
  require_jq >/dev/null

  local name=""
  local use_current=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --current) use_current=true; shift ;;
      -*) die_with_code "${E_GENERIC}" "unknown flag '$1'." ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "${name}" ]] || die_with_code "${E_GENERIC}" "usage: opencode-profile make <name> [--current]"
  validate_profile_name "${name}"
  ensure_dirs

  if state_has_profile "${name}"; then
    die_with_code "${E_GENERIC}" "profile '${name}' already exists. Delete it first or choose another name."
  fi

  if [[ "${use_current}" == "true" ]]; then
    [[ -f "${ACTIVE_CREDENTIALS_FILE}" ]] \
      || die_with_code "${E_GENERIC}" "live credentials file not found (${ACTIVE_CREDENTIALS_FILE})."
    atomic_copy_json "${ACTIVE_CREDENTIALS_FILE}" "${PROFILES_DIR}/${name}.json"
    state_rebuild "${name}"
    success "created profile '${name}' from current auth and set as active."
  else
    local dest="${PROFILES_DIR}/${name}.json"
    local tmp
    tmp="$(mktemp -p "${PROFILES_DIR}" .oc-profile.make.XXXXXX)"
    chmod 600 "${tmp}" 2>/dev/null || true
    printf '{}\n' > "${tmp}"
    chmod 600 "${tmp}" 2>/dev/null || true
    mv -f "${tmp}" "${dest}"
    chmod 600 "${dest}" 2>/dev/null || true
    local current_active
    current_active="$(state_active_profile)"
    state_rebuild "${current_active}"
    success "created profile '${name}'."
  fi
}

cmd_switch() {
  require_migrated_layout
  acquire_lock
  require_jq >/dev/null

  local name=""
  local save_current=""
  local trust_mismatch=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --save-current)      save_current="yes"; shift ;;
      --no-save-current)   save_current="no";  shift ;;
      --trust-mismatch)    trust_mismatch="yes"; shift ;;
      --abort-on-mismatch) trust_mismatch="no";  shift ;;
      -*) die_with_code "${E_GENERIC}" "unknown flag '$1'." ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "${name}" ]] \
    || die_with_code "${E_GENERIC}" "usage: opencode-profile switch <name> [--save-current|--no-save-current] [--trust-mismatch|--abort-on-mismatch]"
  validate_profile_name "${name}"
  ensure_dirs

  state_has_profile "${name}" \
    || die_with_code "${E_GENERIC}" "profile '${name}' does not exist. Run 'opencode-profile list' to see available profiles."

  # Capture target profile hash from state before any potential rebuild.
  local recorded_sha
  recorded_sha="$(state_profile_sha "${name}")"

  local current
  current="$(state_active_profile)"
  if [[ "${current}" == "${name}" ]]; then
    info "already on profile '${name}'."
    return 0
  fi

  local interactive
  is_interactive && interactive="yes" || interactive="no"

  # ── Dirty-active detection ───────────────────────────────
  # Only relevant when there is a known current profile whose credentials we could save.
  # If current is empty or its file is gone there is nothing to compare or save; skip.
  local live_sha saved_sha dirty=false
  if [[ -n "${current}" && -f "${PROFILES_DIR}/${current}.json" ]]; then
    live_sha="$(canonical_hash_file "${ACTIVE_CREDENTIALS_FILE}")"
    saved_sha="$(canonical_hash_file "${PROFILES_DIR}/${current}.json")"
    [[ "${live_sha}" == "${saved_sha}" ]] || dirty=true
  fi

  if [[ "${dirty}" == "true" ]]; then
    if [[ "${interactive}" != "yes" ]]; then
      [[ "${save_current}" == "yes" || "${save_current}" == "no" ]] \
        || die_with_code "${E_PROMPT_NONINT}" \
             "prompt required to handle dirty active credentials (non-interactive: pass --save-current or --no-save-current)."
    else
      if [[ "${save_current}" != "yes" && "${save_current}" != "no" ]]; then
        save_current="$(prompt_yes_no \
          "active credentials differ from saved '${current}'. Save current before switching?" "yes")"
      fi
    fi

    if [[ "${save_current}" == "yes" ]]; then
      [[ -n "${current}" ]] \
        || die_with_code "${E_GENERIC}" "cannot save dirty credentials: no active profile name in state."
      atomic_copy_json "${ACTIVE_CREDENTIALS_FILE}" "${PROFILES_DIR}/${current}.json"
      state_rebuild "${current}"
    fi
  fi

  # ── Hash mismatch detection for the target profile ───────
  local computed_sha
  computed_sha="$(canonical_hash_file "${PROFILES_DIR}/${name}.json")"

  if [[ -n "${recorded_sha}" && "${computed_sha}" != "${recorded_sha}" ]]; then
    if [[ "${interactive}" != "yes" ]]; then
      [[ "${trust_mismatch}" == "yes" ]] \
        || die_with_code "${E_HASH_MISMATCH}" \
             "hash mismatch refused (non-interactive: pass --trust-mismatch to proceed)."
    else
      if [[ "${trust_mismatch}" != "yes" && "${trust_mismatch}" != "no" ]]; then
        trust_mismatch="$(prompt_yes_no \
          "saved profile '${name}' hash differs from recorded state. Trust and update?" "yes")"
      fi
      [[ "${trust_mismatch}" == "yes" ]] \
        || die_with_code "${E_HASH_MISMATCH}" "hash mismatch refused."
    fi
    state_rebuild "${current}"
  fi

  # ── Apply switch ─────────────────────────────────────────
  atomic_copy_json "${PROFILES_DIR}/${name}.json" "${ACTIVE_CREDENTIALS_FILE}"
  state_rebuild "${name}"

  if pgrep -x opencode >/dev/null 2>&1; then
    warn "warning: opencode appears to be running. Restart it to apply the switch."
  fi
  success "switched to '${name}'. Restart opencode to apply."
}

cmd_list() {
  if state_is_valid; then
    local current
    current="$(state_active_profile)"
    local profiles=()
    mapfile -t profiles < <(state_list_profiles)

    if [[ ${#profiles[@]} -eq 0 ]]; then
      info "no profiles saved yet."
      echo ""
      return 0
    fi

    echo ""
    echo -e "${BOLD}OpenAI profiles:${RESET}"
    echo ""
    for p in "${profiles[@]}"; do
      if [[ "${p}" == "${current}" ]]; then
        echo -e "  ${GREEN}* ${p}${RESET} ${DIM}(active)${RESET}"
      else
        echo -e "    ${p}"
      fi
    done
    echo ""
    return 0
  fi

  info "no profiles saved yet."
  echo ""
}

cmd_which() {
  state_is_valid || die_with_code "${E_GENERIC}" "no active profile found."
  local current
  current="$(state_active_profile)"
  [[ -n "${current}" ]] || die_with_code "${E_GENERIC}" "no active profile found."
  echo "${current}"
}

cmd_delete() {
  require_migrated_layout
  acquire_lock
  require_jq >/dev/null

  local name="${1:-}"
  [[ -n "${name}" ]] || die_with_code "${E_GENERIC}" "usage: opencode-profile delete <name>"
  validate_profile_name "${name}"
  ensure_dirs

  state_has_profile "${name}" \
    || die_with_code "${E_GENERIC}" "profile '${name}' does not exist."

  local count
  count="$(state_list_profiles | wc -l | tr -d ' ')"
  [[ "${count}" -gt 1 ]] || die_with_code "${E_GENERIC}" "cannot delete the last profile."

  local current
  current="$(state_active_profile)"
  [[ "${current}" != "${name}" ]] \
    || die_with_code "${E_GENERIC}" "cannot delete the active profile. Switch to another profile first."

  local unknowns=""
  unknowns="$(profiles_unknown_files 2>/dev/null || true)"
  [[ -z "${unknowns}" ]] \
    || die_with_code "${E_GENERIC}" "unrecognized JSON file(s) in profiles directory:\n${unknowns}"

  rm -f "${PROFILES_DIR}/${name}.json"
  state_rebuild "${current}"
  success "deleted profile '${name}'."
}

cmd_rename() {
  require_migrated_layout
  acquire_lock
  require_jq >/dev/null

  local old="${1:-}"
  local new="${2:-}"
  [[ -n "${old}" && -n "${new}" ]] || die_with_code "${E_GENERIC}" "usage: opencode-profile rename <old> <new>"
  validate_profile_name "${old}"
  validate_profile_name "${new}"

  state_has_profile "${old}" \
    || die_with_code "${E_GENERIC}" "profile '${old}' does not exist."
  ! state_has_profile "${new}" \
    || die_with_code "${E_GENERIC}" "profile '${new}' already exists."

  local current
  current="$(state_active_profile)"

  mv "${PROFILES_DIR}/${old}.json" "${PROFILES_DIR}/${new}.json"
  [[ "${current}" == "${old}" ]] && current="${new}"
  state_rebuild "${current}"
  success "renamed '${old}' -> '${new}'."
}

# ── Main dispatch ──────────────────────────────────────────

cmd="${1:-help}"
shift || true

case "${cmd}" in
  migrate)           cmd_migrate "$@" ;;
  make)              cmd_make "$@" ;;
  switch)            cmd_switch "$@" ;;
  list|ls)           cmd_list ;;
  which)             cmd_which ;;
  delete|rm)         cmd_delete "$@" ;;
  rename|mv)         cmd_rename "$@" ;;
  version|--version) cmd_version ;;
  help|--help|-h)    cmd_help ;;
  *) die "unknown command '${cmd}'. Run 'opencode-profile help' for usage." ;;
esac
